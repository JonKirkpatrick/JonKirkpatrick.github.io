---
import bbsLogo from '../../assets/BBS/BBS_Logo_Concept_Small.png';
import tactileLogo from '../../assets/CNN/Tactile_Small.png';
import torusImage from '../../assets/Torus/Title_Card.png';
import honeydewAward from '../../assets/About/BestGame_HoneyDew.png';
import honeydewLogo from '../../assets/HoneydewHollow/Stuart_Action.png';
import { Image } from 'astro:assets';
import '../styles/site.css';

const projects = [
  {
    number: '01',
    title: 'Build-a-Bot Stadium',
    category: 'Distributed AI experimentation',
    description: 'A modular client/server platform for running AI and reinforcement-learning experiments across extensible environments.',
    image: bbsLogo,
    technologies: ['Go', 'C# / Avalonia', 'JavaScript', 'SQLite'],
    href: '/projects/bbs/'
  },
  {
    number: '02',
    title: 'Tactile Pattern Classification',
    category: 'Software / hardware co-design',
    description: 'A complete path from noisy robotic sensor data and model training to FPGA-ready, quantized inference artifacts.',
    image: tactileLogo,
    technologies: ['SystemVerilog', 'PyTorch', 'NumPy', 'FPGA'],
    href: '/projects/tactile/'
  },
  {
    number: '03',
    title: 'Torus Knots and Curvy Plots',
    category: 'Computational geometry',
    description: 'A numerical and physical investigation into turning torus-knot geometry into printable, verifiable manifolds.',
    image: torusImage,
    technologies: ['Python', 'SciPy', 'Shapely', 'Blender'],
    href: '/projects/torus/'
  },
  {
    number: '04',
    title: 'Honeydew Hollow',
    category: 'Collaborative game project',
    description: 'A team-built game project, presented through its trailer and a Best Game award certificate.',
    image: honeydewLogo,
    technologies: ['C++', 'ECS', 'SFML', 'GLSL'],
    href: '/projects/honeydew/'
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="The software engineering portfolio of Jon Kirkpatrick." />
    <title>Jon Kirkpatrick | Software and AI Engineering</title>
    <script data-goatcounter="https://jonkirkpatrick.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Jon Kirkpatrick home">JK<span>.</span></a>
      <nav aria-label="Primary navigation">
        <a href="#work">Selected work</a>
        <a href="#about">About</a>
        <a class="nav-button" href="mailto:jon.kirkpatrick@pm.me">Get in touch</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Software / AI / systems</p>
          <h1 id="hero-title">I build systems around difficult problems.</h1>
          <p class="hero-intro">I'm Jon Kirkpatrick, an aspiring software engineer with a background in mathematics and a habit of following interesting problems all the way from first principles to working artifacts.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">Explore the work <span aria-hidden="true">↓</span></a>
            <a class="text-link" href="/jkirkpatrick_resume.pdf" target="_blank" rel="noopener noreferrer">View resume <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <aside class="hero-note" aria-label="Current location and focus">
          <span class="note-line"></span>
          <p>Based in<br /><strong>St. John's, NL</strong></p>
          <p>Interested in<br /><strong>AI, Mathematics, and<br />Computational Systems</strong></p>
        </aside>
      </section>

      <section class="work-section" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <p class="eyebrow">A selection of projects</p>
          <h2 id="work-title">Work with a point of view.</h2>
          <p>I use software to understand problems.  When the resulting system solves the stated problem, that becomes evidence I understood it.</p>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <div class="project-image-wrap">
                <Image src={project.image} alt={`${project.title} project mark`} widths={[320, 640, 960]} sizes="(max-width: 900px) 100vw, 33vw" />
                <span class="project-number">{project.number}</span>
              </div>
              <div class="project-content">
                <p class="project-category">{project.category}</p>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <div class="tag-list" aria-label={`${project.title} technologies`}>
                  {project.technologies.map((technology) => <span>{technology}</span>)}
                </div>
                  <a class="card-link" href={project.href}>Read case study <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="about-section" id="about" aria-labelledby="about-title">
        <div>
          <p class="eyebrow">A little context</p>
          <h2 id="about-title">Methodical by training.<br />Curious by disposition.</h2>
        </div>
        <div class="about-copy">
          <p>I came to software after fifteen years diagnosing and repairing damaged vehicles, followed by work in electronics manufacturing and a degree in pure mathematics and computer science.</p>
          <p>That history left me comfortable with systems that are physical, imperfect, and not fully specified. I like making the constraints visible, then finding the structure hiding inside them.</p>
          <p class="about-invitation">Have a difficult problem?  Let's see what we can build around it.</p>
          <a class="text-link" href="mailto:jon.kirkpatrick@pm.me">Start a conversation <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>Jon Kirkpatrick</span>
      <span>Software / AI / systems</span>
      <a href="https://www.linkedin.com/in/jonathan-kirkpatrick-62b428330" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      <a href="https://github.com/JonKirkpatrick" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </footer>
  </body>
</html>
